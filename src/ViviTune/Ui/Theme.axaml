<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Палитра (глобальные ограничения) -->
      <SolidColorBrush x:Key="BgBrush" Color="#0e1120" />
      <SolidColorBrush x:Key="MenuBrush" Color="#0b0d1a" />
      <SolidColorBrush x:Key="CardBrush" Color="#171b2e" />
      <SolidColorBrush x:Key="LineBrush" Color="#252a44" />
      <SolidColorBrush x:Key="TextBrush" Color="#e8eaf6" />
      <SolidColorBrush x:Key="MutedBrush" Color="#8a90b4" />
      <SolidColorBrush x:Key="Accent1Brush" Color="#22d3ee" />
      <SolidColorBrush x:Key="Accent2Brush" Color="#8b5cf6" />
      <SolidColorBrush x:Key="OkBrush" Color="#34d399" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#f87171" />
      <SolidColorBrush x:Key="WarnBrush" Color="#fbbf24" />
      <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="#22d3ee" />
        <GradientStop Offset="1" Color="#8b5cf6" />
      </LinearGradientBrush>
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

      <!-- Шрифт и поля ввода Fluent под палитру -->
      <FontFamily x:Key="ContentControlThemeFontFamily">fonts:Inter#Inter</FontFamily>
      <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
      <SolidColorBrush x:Key="TextControlBackground" Color="#0e1120" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0e1120" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0e1120" />
      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#141829" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#252a44" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#363c62" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#22d3ee" />
      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#1d2138" />
      <SolidColorBrush x:Key="TextControlForeground" Color="#e8eaf6" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#e8eaf6" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#e8eaf6" />
      <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#8a90b4" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8a90b4" />

      <!-- Пункт бокового меню: значок, активный — акцент 1 -->
      <ControlTheme x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
          <Setter Property="Background" Value="#151a2e" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Foreground" Value="{StaticResource Accent1Brush}" />
          <Setter Property="Background" Value="#1a22d3ee" />
        </Style>
      </ControlTheme>

      <!-- Переключатель вкл/выкл (строки приложений): выкл — серый, вкл — градиент -->
      <ControlTheme x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="#2a2f4d" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Background="{TemplateBinding Background}" CornerRadius="9">
              <Ellipse Name="Knob" Width="14" Height="14" Margin="2,0" HorizontalAlignment="Left" Fill="#8a90b4" />
            </Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:checked">
          <Setter Property="Background" Value="{StaticResource AccentGradient}" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#Knob">
          <Setter Property="HorizontalAlignment" Value="Right" />
          <Setter Property="Fill" Value="White" />
        </Style>
        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.5" />
        </Style>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Карточка -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource CardBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- Тексты -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Главная кнопка («＋ Добавить»): градиент акцент 1 → акцент 2.
       Не класс accent: у Fluent есть свой Button.accent, он перекрывает фон шаблона. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="Foreground" Value="#0b0d1a" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="Foreground" Value="#0b0d1a" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentGradient}" />
    <Setter Property="Foreground" Value="#0b0d1a" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <!-- Плоская кнопка-значок («✕» у приложения) -->
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#252a44" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2a2f4d" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
</Styles>
