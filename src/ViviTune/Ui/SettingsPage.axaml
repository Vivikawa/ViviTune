<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:ViviTune.Ui"
             xmlns:vt="using:ViviTune"
             x:Class="ViviTune.Ui.SettingsPage"
             x:DataType="ui:ViewState">
  <UserControl.Styles>
    <Style Selector="Border.card.off">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="TextBlock.ping">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="Border.srv Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
    </Style>
    <Style Selector="Border.srv.sel">
      <Setter Property="Background" Value="#1a2a3e" />
      <Setter Property="BorderBrush" Value="#5522d3ee" />
    </Style>
    <Style Selector="Border.srv.off">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Ellipse.radio">
      <Setter Property="Stroke" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="Ellipse.radio.sel">
      <Setter Property="Stroke" Value="{StaticResource Accent1Brush}" />
      <Setter Property="Fill" Value="{StaticResource Accent1Brush}" />
    </Style>
    <Style Selector="TextBlock.err">
      <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="24,18,24,16">
    <TextBlock Classes="title" Text="Настройки" />
    <ScrollViewer Grid.Row="1" Margin="0,14,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
      <StackPanel Width="460" Spacing="8" Margin="0,0,12,0">
        <TextBlock Text="SOCKS5 · роутер с Podkop" FontWeight="SemiBold" />
        <!-- Блок неактивного режима бледнее, но поля остаются редактируемыми -->
        <Border Classes="card" Classes.off="{Binding IsVless}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,12,100,12,100" RowDefinitions="Auto,6,Auto">
              <TextBlock Classes="muted" Text="IP-адрес роутера" />
              <TextBlock Grid.Column="2" Classes="muted" Text="Прокси" />
              <TextBlock Grid.Column="4" Classes="muted" Text="Мимо Podkop" />
              <TextBox Name="DirectPortBox" Grid.Row="2" Grid.Column="4" MaxLength="5" PlaceholderText="необяз."
                       IsEnabled="{Binding SettingsEditable}" />
              <TextBox Name="IpBox" Grid.Row="2" MaxLength="45" PlaceholderText="192.168.1.1"
                       IsEnabled="{Binding SettingsEditable}" />
              <TextBox Name="PortBox" Grid.Row="2" Grid.Column="2" MaxLength="5" PlaceholderText="1818"
                       IsEnabled="{Binding SettingsEditable}" />
            </Grid>
            <TextBlock Classes="error" Text="{Binding SettingsError}"
                       IsVisible="{Binding SettingsError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Мимо Podkop — Mixed-порт отдельной секции Podkop, инструкция в README." />
          </StackPanel>
        </Border>
        <TextBlock Text="VLESS · для тех, у кого нет роутера с Podkop" FontWeight="SemiBold" Margin="0,8,0,0" />
        <Border Classes="card" Classes.off="{Binding !IsVless}">
          <StackPanel Spacing="6">
            <TextBlock Classes="muted" Text="Ссылка или подписка" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Name="VlessBox" PlaceholderText="vless://…, hysteria2://… или https://… (подписка)" IsEnabled="{Binding SettingsEditable}" />
              <Button Grid.Column="1" Classes="primary" Content="Получить серверы" Margin="8,0,0,0" Click="OnFetch"
                      IsVisible="{Binding IsSubscription}" IsEnabled="{Binding CanFetchNow}" />
            </Grid>
            <StackPanel Spacing="6" IsVisible="{Binding IsSubscription}">
              <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding SubInfoText}"
                         IsVisible="{Binding SubInfoText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="error" Text="{Binding SubError}"
                         IsVisible="{Binding SubError, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,2">
                <TextBlock Text="Выбирать самый быстрый сервер" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" VerticalAlignment="Center"
                              IsChecked="{Binding AutoServer, Mode=OneWay}" Click="OnAutoServer"
                              AutomationProperties.Name="Выбирать самый быстрый сервер" />
                <Button Grid.Column="2" Classes="flat" Content="↻" FontSize="16" Margin="8,0,0,0" Click="OnPing"
                        IsEnabled="{Binding CanPing}" ToolTip.Tip="Проверить серверы" AutomationProperties.Name="Проверить серверы" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Servers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="ui:ServerRow">
                    <Border Classes="srv" Classes.sel="{Binding Selected}" Classes.off="{Binding !Supported}"
                            BorderThickness="1" CornerRadius="7" Margin="0,1">
                      <Button Classes="flat" Tag="{Binding Key}" IsEnabled="{Binding Supported}" Click="OnPickServer"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                          <Ellipse Classes="radio" Classes.sel="{Binding Selected}" Width="12" Height="12" StrokeThickness="2"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextBrush}"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding PingText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Classes="ping"
                                     Classes.ok="{Binding IsOk}" Classes.warn="{Binding IsWarn}" Classes.err="{Binding IsBad}" />
                          <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" FontSize="11" Text="{Binding Reason}"
                                     IsVisible="{Binding HasReason}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </Button>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding VlessSummary}"
                       Classes.ok="{Binding !VlessLinkError}" Classes.err="{Binding VlessLinkError}"
                       IsVisible="{Binding VlessSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="Пока подключено, весь DNS компьютера идёт через VPN (1.1.1.1): провайдер его не видит и не подменяет." />
          </StackPanel>
        </Border>
        <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !SettingsEditable}"
                   Text="Изменить настройки можно после отключения." />
        <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding SettingsEditable}"
                   Text="Сохраняется автоматически." />
        <TextBlock Text="Запуск" FontWeight="SemiBold" Margin="0,8,0,0" />
        <Border Classes="card">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,6,Auto">
            <TextBlock Text="Запускать вместе с Windows" VerticalAlignment="Center" />
            <!-- OneWay: Autostart меняет только App (по RequestSetAutostart); можно и при подключении -->
            <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" VerticalAlignment="Center"
                          IsChecked="{Binding Autostart, Mode=OneWay}" Click="OnAutostart"
                          AutomationProperties.Name="Запускать вместе с Windows" />
            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="muted" TextWrapping="Wrap"
                       Text="ViviTune откроется в трее и сам подключится. Если за три попытки не выйдет, покажет окно с ошибкой." />
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <TextBlock Name="VersionText" Grid.Row="2" Classes="muted" FontSize="11" />
  </Grid>
</UserControl>
