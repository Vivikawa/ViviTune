<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ViviTune.Ui.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#22d3ee" RegionColor="#0e1120" ErrorText="#f87171" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://ViviTune/Ui/Theme.axaml" />
  </Application.Styles>
</Application>
