<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:ViviTune.Ui"
             x:Class="ViviTune.Ui.AppsPage"
             x:DataType="ui:ViewState">
  <UserControl.Resources>
    <!-- Иконка программы или плашка с первой буквой имени; размер и шрифт буквы задаёт ContentControl -->
    <DataTemplate x:Key="Badge" x:DataType="ui:AppRow">
      <Panel>
        <Border CornerRadius="7" Background="{Binding Badge}"
                IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}">
          <TextBlock Text="{Binding Letter}" FontWeight="Bold" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Image Source="{Binding Icon}" RenderOptions.BitmapInterpolationMode="HighQuality"
               IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Panel>
    </DataTemplate>
    <!-- Строка панели «＋ Добавить» (запущенные и фоновые) -->
    <DataTemplate x:Key="PickRow" x:DataType="ui:AppRow">
      <Button Classes="pick" Click="OnPickRunning" ToolTip.Tip="{Binding Path}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <ContentControl Width="20" Height="20" FontSize="11" VerticalAlignment="Center"
                          Content="{Binding}" ContentTemplate="{StaticResource Badge}" />
          <TextBlock Grid.Column="1" Margin="9,0" VerticalAlignment="Center" Text="{Binding Name}"
                     TextTrimming="CharacterEllipsis" />
          <!-- «＋»: значком, у глифа из запасного шрифта слишком тонкая линия -->
          <PathIcon Grid.Column="2" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"
                    Foreground="{StaticResource Accent1Brush}" Data="M10.5 3h3v7.5H21v3h-7.5V21h-3v-7.5H3v-3h7.5z" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Пункт панели «＋ Добавить»: строка во всю ширину, подсветка при наведении -->
    <Style Selector="Button.pick">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.pick:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1d2240" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style Selector="Button.pick:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#252a4d" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <!-- Подпись раздела панели -->
    <Style Selector="TextBlock.lab">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="LetterSpacing" Value="0.7" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Margin" Value="6,10,4,4" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="24,18,24,16">
    <TextBlock Classes="title" Text="Приложения через прокси" />

    <ScrollViewer Name="ListArea" Grid.Row="1" Margin="0,14,0,0">
      <StackPanel Spacing="8">
        <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding !Apps.Count}"
                   Text="Добавьте приложение, трафик которого пойдёт через прокси" />
        <ItemsControl ItemsSource="{Binding Apps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ui:AppRow">
              <Border Classes="card" Padding="12,10" ToolTip.Tip="{Binding Path}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <ContentControl Width="30" Height="30" FontSize="14" VerticalAlignment="Center"
                                  Content="{Binding}" ContentTemplate="{StaticResource Badge}" />
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" FontSize="11" Margin="0,1,0,0" Text="{Binding FileName}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <!-- OneWay: Enabled меняет только App (по RequestSetAppEnabled) -->
                  <ToggleButton Grid.Column="2" Theme="{StaticResource Switch}" VerticalAlignment="Center"
                                IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnToggle"
                                AutomationProperties.Name="Через прокси" />
                  <Button Grid.Column="3" Classes="flat" Content="✕" Margin="10,0,0,0" VerticalAlignment="Center"
                          Click="OnRemove" AutomationProperties.Name="Убрать из списка" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Name="AddButton" Classes="primary" Content="＋ Добавить" HorizontalAlignment="Left" Margin="0,2,0,0" />
      </StackPanel>
    </ScrollViewer>

    <!-- Выпадающая панель «＋ Добавить» у правого верхнего угла списка, как в макете.
         В слое окна (ShouldUseOverlayLayer): так её видят и снимки Shots. -->
    <Popup Name="AddPopup" Grid.Row="1" Placement="AnchorAndGravity" PlacementAnchor="TopRight" PlacementGravity="BottomLeft"
           IsLightDismissEnabled="True" ShouldUseOverlayLayer="True">
      <Border Width="300" Background="#121629" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
              CornerRadius="12" Padding="10" BoxShadow="0 12 40 0 #80000000">
        <Border.Resources>
          <!-- Поле поиска — цвета карточки, как в макете -->
          <SolidColorBrush x:Key="TextControlBackground" Color="#171b2e" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#171b2e" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#171b2e" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#171b2e" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#252a44" />
        </Border.Resources>
        <StackPanel>
          <TextBox Name="SearchBox" PlaceholderText="Поиск…" FontSize="13" CornerRadius="8">
            <TextBox.InnerLeftContent>
              <PathIcon Width="14" Height="14" Margin="10,0,0,0" Foreground="{StaticResource MutedBrush}"
                        Data="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
            </TextBox.InnerLeftContent>
          </TextBox>

          <!-- «Запущены сейчас» прописными, как text-transform в макете -->
          <TextBlock Classes="lab" Text="ЗАПУЩЕНЫ СЕЙЧАС" />
          <ScrollViewer MaxHeight="252">
            <StackPanel>
              <ItemsControl Name="RunningList" ItemTemplate="{StaticResource PickRow}" />
              <TextBlock Name="RunningHint" Classes="muted" Margin="6,4" />
              <!-- Без окна: службы, помощники, консольные утилиты, свёрнутые в трей. Свёрнуто; при поиске раскрыто. -->
              <Button Name="BgButton" Classes="pick">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <PathIcon Name="BgChevron" Width="20" Height="12" Foreground="{StaticResource MutedBrush}"
                            Data="M8.6 16.6 13.2 12 8.6 7.4 10 6l6 6-6 6z" />
                  <TextBlock Name="BgText" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <ItemsControl Name="BgList" ItemTemplate="{StaticResource PickRow}" />
            </StackPanel>
          </ScrollViewer>

          <TextBlock Classes="lab" Text="ДРУГОЕ" />
          <Button Name="PickFileButton" Classes="pick">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <!-- ширина как у плашки строки выше: текст на одной линии с именами -->
              <PathIcon Width="20" Height="16" Foreground="#f5c451"
                        Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
              <TextBlock Text="Выбрать .exe вручную…" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
